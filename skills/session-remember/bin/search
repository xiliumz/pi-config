#!/usr/bin/env bash
# Grep a pattern (extended regex) across all sessions in the current bucket.
# Usage: search "keyword1|keyword2|phrase"
set -eu
pattern="${1:-}"
if [[ -z "$pattern" ]]; then
  echo "usage: search <regex-pattern>" >&2
  exit 2
fi
inner=$(echo "${PWD#/}" | tr '/' '-')
BUCKET="${HOME}/.pi/agent/sessions/--${inner}--/"
shopt -s nullglob
files=("$BUCKET"*.jsonl)
if [[ ${#files[@]} -eq 0 ]]; then
  echo "(no sessions in $BUCKET)" >&2
  exit 0
fi
# -l: list filenames only. Add -i for case-insensitive at the call site if needed.
grep -lE "$pattern" "${files[@]}" 2>/dev/null || echo "(no matches)"
