{
  "lastChangelogVersion": "0.80.10",
  "defaultProvider": "xai",
  "defaultModel": "grok-4.5",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "xai/grok-4.5"
  ],
  "editorPaddingX": 0,
  "hideThinkingBlock": false,
  "terminal": {
    "showTerminalProgress": true
  },
  "packages": [
    {
      "source": "npm:pi-hashline-edit",
      "extensions": [
        "-index.ts"
      ],
      "prompts": [
        "-prompts/edit-guidelines.md",
        "-prompts/edit-snippet.md",
        "-prompts/edit.md",
        "-prompts/grep-snippet.md",
        "-prompts/grep.md",
        "-prompts/read-snippet.md",
        "-prompts/read-guidelines.md",
        "-prompts/read.md"
      ]
    },
    "npm:context-mode",
    "npm:pi-mcp-adapter",
    "git:github.com/xiliumz/pi-minimal"
  ],
  "theme": "dark"
}